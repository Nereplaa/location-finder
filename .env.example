# AKİS — Ortam Değişkeni Şablonu
# Bu dosyayı .env olarak kopyala ve değerleri ayarla:
#   cp .env.example .env

# ──────────────────────────────────────────
# Zorunlu
# ──────────────────────────────────────────

# Flask gizli anahtarı — üretimde güçlü, rastgele bir değer kullan
# Örnek üretim değeri: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-change-in-production

# POS entegrasyon API anahtarı — POS sistemlerinin webhook çağrısında göndereceği anahtar
POS_API_KEY=dev-pos-api-key-change-in-production

# ──────────────────────────────────────────
# Veritabanı (sadece üretim için)
# ──────────────────────────────────────────

# Geliştirme ortamında SQLite kullanılır (instance/avm.db)
# Üretimde PostgreSQL bağlantı dizesini ayarla:
# DATABASE_URL=postgresql://kullanici:sifre@localhost:5432/akis_db

# ──────────────────────────────────────────
# E-posta (opsiyonel — stok bildirimleri için)
# ──────────────────────────────────────────

# Geliştirme ortamında e-posta gönderimi otomatik bastırılır
# Üretimde gerçek SMTP ayarlarını gir:
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-password
# MAIL_DEFAULT_SENDER=noreply@akis-avm.com

# ──────────────────────────────────────────
# Flask (opsiyonel)
# ──────────────────────────────────────────

# FLASK_ENV=development    # veya production
# FLASK_DEBUG=1            # sadece geliştirme için
